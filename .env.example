# DockProbe Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Authentication (required, minimum 8 characters for password)
AUTH_USER=admin
AUTH_PASS=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anomaly thresholds (optional)
# Container CPU is a percentage where 100% is one core, so leaving CPU_THRESHOLD
# unset scales it with the machine: 80 x cores. Set it to pin a fixed number.
#CPU_THRESHOLD=1600
MEM_THRESHOLD=90

# Max simultaneous connections (optional, 0 = unlimited)
MAX_CONNECTIONS=3

# Port (optional, default 9090)
MONITOR_PORT=9090

# Cloudflare Tunnel (optional, for --profile tunnel)
CF_TUNNEL_TOKEN=

# Trusted proxy IPs for X-Forwarded-For (comma-separated, optional)
TRUSTED_PROXIES=
